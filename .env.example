# Postgres connection string (Neon / Supabase / Railway all work)
DATABASE_URL="postgresql://user:password@host:5432/careercompass?sslmode=require"

# --- AI provider (pick ONE path below) ---
#
# Option A — Gemini (free, no credit card): get a key at
# https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=""

# Option B — Anthropic (requires a funded Console account):
# https://console.anthropic.com. Leave as "mock" if using Gemini above, or
# to run the whole app with canned responses and no AI account at all.
ANTHROPIC_API_KEY="mock"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
